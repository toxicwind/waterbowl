{
  "author": "Lizzard Solutions",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "playwright": "^1.40.0",
    "puppeteer": "^21.0.0",
    "ws": "^8.14.0",
    "zod": "^3.22.0"
  },
  "description": "Persistent shared headed browser + agent surface (geode, keeper lineage). CDP :25234, Xvnc :99 display, quickshell ii surface on DP-2.",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "name": "waterbowl",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "format": "prettier --write src/**/*.ts",
    "keeper": "node keeper.cjs",
    "lint": "eslint src/**/*.ts",
    "start": "node dist/index.js",
    "test": "node smoke/keeper-smoke.mjs",
    "test:gatehouse": "bun smoke/gatehouse-smoke.ts",
    "validate": "bun run typecheck && bun run test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "1.3.0",
  "keywords": [
    "browser",
    "keeper",
    "cdp",
    "persistent",
    "geode"
  ]
}
